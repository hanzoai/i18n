{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // These packages ship TypeScript: `main` is `src/index.ts`, Node strips
    // types, and every bundler downstream reads them. There is nothing to emit,
    // so imports name the file that actually exists.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}
