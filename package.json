{
  "name": "hanzoai-i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Universal translation pipeline for the Hanzo / Lux / Zoo / Pars ecosystem.",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "pkgs/*",
    "tools/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter './pkgs/*' build",
    "extract": "pnpm --filter @hanzo/i18n-extract run extract",
    "translate": "pnpm --filter @hanzo/i18n-translate run translate",
    "validate": "pnpm --filter @hanzo/i18n-validate run validate",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
