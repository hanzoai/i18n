{
  "name": "@hanzo/i18n-validate",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "i18n-validate": "dist/cli.js"
  },
  "dependencies": {
    "@hanzo/i18n": "workspace:^"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "node ../../scripts/pack.mjs && npm run build",
    "test": "node --test --experimental-strip-types test/*.ts",
    "typecheck": "../../node_modules/tsgo/bin/tsc --noEmit --incremental false"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "6.0.3"
  },
  "main": "dist/check.js",
  "types": "dist/check.d.ts",
  "exports": {
    ".": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    }
  },
  "files": [
    "dist"
  ]
}
